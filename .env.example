# Daju Environment Variables Example
# Copy to .env.local for local development.

# Application URL (used for card links and canonical references)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram Bot (Forward it to Daju)
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Random secret; Telegram sends it back with every update, and it is the bearer token for POST /api/telegram/setup
TELEGRAM_WEBHOOK_SECRET=
# Bot username for the links on the site; found automatically from the token when left empty
NEXT_PUBLIC_TELEGRAM_BOT=

# WhatsApp through Twilio: point the sandbox "when a message comes in" URL at /api/whatsapp/webhook
# Auth token from the Twilio console; requests are rejected without a valid signature when it is set
TWILIO_AUTH_TOKEN=
# Only needed when the public URL differs from NEXT_PUBLIC_SITE_URL/api/whatsapp/webhook
TWILIO_WEBHOOK_URL=

# Database / Supabase (Optional for local dev; MemoryStore is used as fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# Token for POST /api/db/init table setup
DB_INIT_TOKEN=

# Optional AI / Extraction Refinement & Translation (Rule engine works without any keys)
# Set to 'groq' or 'anthropic'
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
TRUECOPY_MODEL=claude-opus-5

# Company registers, both optional. Without keys the card offers the official search with the name ready to paste.
# OpenCorporates: a dated index of CAC, BRS, URSB and ORC; free API keys are granted to public-benefit projects on request
OPENCORPORATES_API_TOKEN=
# Mono: licensed live CAC lookup for Nigeria, billed per call; used ahead of the index when set
MONO_SECRET_KEY=

# Optional Social Links (Footer)
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# Licence watch: weekly cron (vercel.json) calls /api/watch/notify with this bearer token
CRON_SECRET=
# Emails go out through Resend when set; without it the cron reports changes but sends nothing
RESEND_API_KEY=
RESEND_FROM=Daju <onboarding@resend.dev>
